{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nopenwrtremote-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NOSTR_RELAY",
        "class_name": "NostrRelayDO"
      },
      {
        "name": "TUNNEL_ROOM",
        "class_name": "TunnelRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NostrRelayDO", "TunnelRoomDO"]
    }
  ],
  "routes": [
    { "pattern": "relay.gfmm.eu/*", "zone_name": "gfmm.eu" },
    { "pattern": "gfmm.eu/nopenwrtremote*", "zone_name": "gfmm.eu" }
  ]
}
