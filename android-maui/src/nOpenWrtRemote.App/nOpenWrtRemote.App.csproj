<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>nOpenWrtRemote.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiVersion>10.0.20</MauiVersion>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>nOpenWrtRemote</ApplicationTitle>
    <ApplicationId>eu.gfmm.nopenwrtremote</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1120" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1120" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\nOpenWrtRemote.Core\nOpenWrtRemote.Core.csproj" />
  </ItemGroup>
</Project>
