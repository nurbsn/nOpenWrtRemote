<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:nOpenWrtRemote.Core.Models;assembly=nOpenWrtRemote.Core"
             xmlns:vm="clr-namespace:nOpenWrtRemote.App.ViewModels"
             x:Class="nOpenWrtRemote.App.Views.RouterListPage"
             x:DataType="vm:RouterListViewModel"
             Title="nOpenWrtRemote"
             BackgroundColor="#0B1120">

  <ContentPage.ToolbarItems>
    <ToolbarItem Text="Ustawienia" Command="{Binding GoToSettingsCommand}" />
  </ContentPage.ToolbarItems>

  <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
    <Border Grid.Row="0" BackgroundColor="#111A2E" Stroke="#1E293B" StrokeShape="RoundRectangle 12" Padding="14">
      <VerticalStackLayout Spacing="4">
        <Label Text="Zero-Knowledge E2EE • Protokół NORT-1" FontSize="12" TextColor="#38BDF8" FontAttributes="Bold" />
        <Label Text="Zdalne zarządzanie OpenWrt i pełnym LuCI bez otwierania portów WAN (Nostr + AES-256-GCM)."
               FontSize="13" TextColor="#94A3B8" />
      </VerticalStackLayout>
    </Border>

    <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12"
                         IsVisible="{Binding HasRouters, Converter={StaticResource InvertedBoolConverter}}">
      <Label Text="Brak sparowanych routerów" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
      <Label Text="Zainstaluj pakiet nopenwrtremote + luci-app-nopenwrtremote na routerze i zeskanuj kod QR w LuCI."
             FontSize="14" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>

    <CollectionView Grid.Row="1" ItemsSource="{Binding Routers}" IsVisible="{Binding HasRouters}">
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:RouterProfile">
          <Border BackgroundColor="#111A2E" Stroke="#1E293B" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="White" />
              <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#052E16" StrokeShape="RoundRectangle 8" Padding="8,3">
                <Label Text="E2EE" TextColor="#22C55E" FontSize="11" FontAttributes="Bold" />
              </Border>
              <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RouterNpub}" FontSize="11" TextColor="#94A3B8" LineBreakMode="MiddleTruncation" />
              <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="10" Margin="0,6,0,0">
                <Button Text="Połącz (tunel E2EE)"
                        BackgroundColor="#0284C7" TextColor="White" CornerRadius="10"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RouterListViewModel}}, Path=ConnectCommand}"
                        CommandParameter="{Binding .}" />
                <Button Text="Usuń"
                        BackgroundColor="#1E293B" TextColor="#F87171" CornerRadius="10"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RouterListViewModel}}, Path=RemoveCommand}"
                        CommandParameter="{Binding .}" />
              </HorizontalStackLayout>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <VerticalStackLayout Grid.Row="2" Spacing="8">
      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#38BDF8" />
      <Label Text="{Binding StatusMessage}" TextColor="#38BDF8" FontSize="13" HorizontalTextAlignment="Center" />
      <Button Text="+ Sparuj router (Kod QR / Link)"
              BackgroundColor="#38BDF8" TextColor="#0B1120" FontAttributes="Bold" HeightRequest="50" CornerRadius="12"
              Command="{Binding GoToPairCommand}" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
